PORT=5050
CLIENT_URL=http://localhost:3000
# Main SaaS domain. Gyms live at <slug>.ROOT_DOMAIN (in dev: ironpulse.localhost:3000)
ROOT_DOMAIN=localhost:3000
JWT_SECRET=change-this-to-a-long-random-string

# PostgreSQL (docker compose up -d db)
DATABASE_URL=postgresql://gymflow:gymflow@localhost:5433/gymflow

# Platform super admin (created by the seed)
ADMIN_EMAIL=admin@gym.com
ADMIN_PASSWORD=admin12345

# Stripe test mode (free). Leave empty to use "demo billing" mode
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: Cloudinary (if empty, images are saved to backend/uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
