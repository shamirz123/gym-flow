# Backend (Express API) URL, as seen from the browser
NEXT_PUBLIC_API_URL=http://localhost:5050
# Main SaaS domain. Every gym: <slug>.<ROOT_DOMAIN>  (dev: ironpulse.localhost:3000)
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
# Optional: internal backend URL for server-side requests (Docker), otherwise NEXT_PUBLIC_API_URL
# API_URL_INTERNAL=http://api:5050
